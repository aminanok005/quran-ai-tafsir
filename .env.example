# Copy to .env for local API development. Never put real credentials in this file.

# API runtime
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_DEFAULT_LOCALE=th
APP_SUPPORTED_LOCALES=th,ar,en

# Local PostgreSQL defaults matching docker/docker-compose.yml
POSTGRES_HOST_PORT=5432
POSTGRES_DB=quran_ai
POSTGRES_USER=quran_ai
POSTGRES_PASSWORD=quran_ai_dev
DATABASE_URL=postgresql+psycopg://quran_ai:quran_ai_dev@localhost:5432/quran_ai

# Optional Redis
REDIS_URL=redis://localhost:6379/0

# Quran Foundation Content API. Keep credentials server-side.
QURAN_API_BASE_URL=https://apis.quran.foundation
QURAN_API_CLIENT_ID=REPLACE_WITH_APPROVED_CLIENT_ID
QURAN_API_CLIENT_SECRET=REPLACE_WITH_SECRET
QURAN_API_TAFSIR_SCOPE=content.tafsirs.read
QURAN_API_TOKEN_CACHE_TTL_SECONDS=3300
QURAN_API_TAFSIR_CACHE_TTL_SECONDS=300
QURAN_TAFSIR_RESOURCE_MAP={"ibn_kathir":168}

# Optional local 9Router Studio/translation provider. Set a real local key in .env.local.
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=REPLACE_WITH_LOCAL_9ROUTER_KEY
LLM_MODEL=9router-combos
LLM_API_WIRE_API=responses
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.1

# Optional embeddings. Separate credentials from LLM_API_KEY.
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_BASE_URL=http://127.0.0.1:20128/v1
# EMBEDDING_API_KEY=REPLACE_WITH_LOCAL_EMBEDDING_KEY
# EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_DIMENSIONS=1536
# EMBEDDING_TIMEOUT_SECONDS=30

# Optional vector database and Strapi CMS
# VECTOR_DB_URL=
# VECTOR_DB_COLLECTION=quran_tafsir
# STRAPI_API_BASE_URL=http://localhost:1337
# STRAPI_API_TOKEN=REPLACE_WITH_STRAPI_TOKEN

# Security: generate unique values for any non-local deployment.
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
